# ==========================================================
# Configuracao do servidor
# ==========================================================
PORT=3001

# URL do frontend, usada pelo CORS (troque se o seu frontend
# rodar em outra porta, ex: http://localhost:5173 para Vite)
FRONTEND_URL=http://localhost:5173

# ==========================================================
# Banco de dados
# ==========================================================
# 'sqlite' nao exige instalar nenhum servidor de banco.
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Autenticacao (JWT)
